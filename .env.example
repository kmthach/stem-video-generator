# Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model
GEMINI_MODEL=gemini-3.5-flash

# Default TTS Voice (Edge-TTS)
# Examples: en-US-ChristopherNeural, en-US-JennyNeural, en-US-GuyNeural, en-GB-SoniaNeural
DEFAULT_VOICE=en-US-ChristopherNeural

# Default Video Render Quality: low (480p), medium (720p), high (1080p), four_k (2160p)
DEFAULT_QUALITY=low

# Default Output Directory
OUTPUT_DIR=./output

# Max retry attempts for Manim code self-healing loop
MAX_HEALING_RETRIES=3

# MySQL Database Settings (Matches docker-compose.yml)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=stem_user
MYSQL_PASSWORD=stem_password
MYSQL_DATABASE=stem_videos
DATABASE_URL=mysql+pymysql://stem_user:stem_password@localhost:3306/stem_videos?charset=utf8mb4

# Redis Task Queue Settings (Matches docker-compose.yml)
REDIS_URL=redis://localhost:6379/0
MAX_QUEUE_WORKERS=5

# FastAPI Server Settings
API_HOST=0.0.0.0
API_PORT=8000
